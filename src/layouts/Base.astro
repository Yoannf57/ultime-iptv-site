---
import config from "../../site.config.mjs";
import { t } from "../lib/textes";
import { pays, hreflang, estInternational, trouverPays } from "../lib/pays";
import { lienAbsolu, lien } from "../lib/liens";
import { getImage } from "astro:assets";
import { image, captures } from "../lib/captures";
import Bandeau from "../components/Bandeau.astro";
import PiedDePage from "../components/PiedDePage.astro";

interface Props {
  langue: string;          // langue des textes (fr, en…)
  lang?: string;           // attribut lang de la page (fr-FR…), par défaut = langue
  titre: string;
  description: string;
  chemin: string;          // chemin de la page, sans la base (ex. « fr-fr/ »)
  codePays?: string;       // pays affiché (absent sur les pages de choix)
  alternatives?: boolean | string;  // balises hreflang vers les autres pays (texte = sous-page, ex. « privacy/ »)
  languesPied?: string[];  // pages bilingues : langues du pied de page
  erreur?: boolean;        // page 404 : jamais indexée, pas d'adresse canonique
}
const { langue, lang = langue, titre, description, chemin, codePays, alternatives = false, languesPied, erreur = false } = Astro.props;
const direction = t(langue, "meta.direction");
const canonique = lienAbsolu(chemin, Astro.site);
const sousChemin = typeof alternatives === "string" ? alternatives : "";
// Partage (Open Graph, X/Twitter) : titre, description, adresse canonique et une image par langue, la vraie capture de
// l'accueil sur Apple TV (liste de démonstration), en JPEG 1200 px de large pour tous les réseaux.
const partage = erreur ? null : await getImage({ src: image(langue, "appletv", captures.apercu.ecrans.appletv.accueil), width: 1200, format: "jpeg", quality: 82 });
const imagePartage = partage ? new URL(partage.src, Astro.site).href : null;
const localeOg = lang.includes("-") ? lang.replace("-", "_") : ({ en: "en_US", fr: "fr_FR", nl: "nl_NL", de: "de_DE", sv: "sv_SE", nb: "nb_NO", da: "da_DK", fi: "fi_FI", es: "es_ES", it: "it_IT", pt: "pt_PT" } as Record<string, string>)[lang] ?? lang;
---
<!doctype html>
<html lang={lang} dir={direction}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {(!config.indexable || erreur) && <meta name="robots" content="noindex" />}
    {!erreur && <link rel="canonical" href={canonique} />}
    {alternatives && pays.map((p) => (
      <link rel="alternate" hreflang={hreflang(p)} href={lienAbsolu(`${p.code}/${sousChemin}`, Astro.site)} />
    ))}
    {alternatives && <link rel="alternate" hreflang="x-default" href={lienAbsolu(`en/${sousChemin}`, Astro.site)} />}
    {/* Smart App Banner : Safari (iPhone, iPad) affiche lui-même le bandeau « Ouvrir dans l'App Store ». Seulement une
        fois l'app publiée, et seulement sur les pages d'un pays ou d'une langue (jamais page de choix ni 404). */}
    {config.disponible && codePays && !erreur && <meta name="apple-itunes-app" content={`app-id=${config.appStore.id}`} />}
    {!erreur && <>
      <meta property="og:site_name" content="Ulti" />
      <meta property="og:type" content="website" />
      <meta property="og:title" content={titre} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={canonique} />
      <meta property="og:locale" content={localeOg} />
      {imagePartage && <meta property="og:image" content={imagePartage} />}
      {imagePartage && <meta property="og:image:width" content={String(partage!.attributes.width ?? 1200)} />}
      {imagePartage && <meta property="og:image:height" content={String(partage!.attributes.height ?? 675)} />}
      {imagePartage && <meta property="og:image:alt" content={t(langue, "partage.imageAlt")} />}
      <meta name="twitter:card" content="summary_large_image" />
    </>}
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href={lien("favicon.svg")} type="image/svg+xml" />
    <slot name="tete" />
  </head>
  <body>
    {codePays && !estInternational(trouverPays(codePays)) && <Bandeau langue={langue} codePays={codePays} />}
    <slot />
    <PiedDePage langue={langue} codePays={codePays} langues={languesPied} />
  </body>
</html>

<style is:global>
  :root {
    --fond: #000000;
    --surface: #141416;
    --surface-2: #242428;
    --texte: #f5f5f7;
    --texte-2: #a1a1a6;
    --police: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--fond); color: var(--texte); font-family: var(--police); font-size: 100%; -webkit-text-size-adjust: 100%; }
  body { margin: 0; min-height: 100vh; display: flex; flex-direction: column; line-height: 1.5; }
  /* Les halos derrière les appareils débordent un peu sur les côtés : coupés au bord de l'écran, sinon la page
     glisse de gauche à droite sur téléphone (clip, pas hidden : la barre du haut reste collée en haut). */
  main { flex: 1; overflow-x: clip; }
  a { color: inherit; }
  :focus-visible { outline: 0.125rem solid var(--texte); outline-offset: 0.1875rem; border-radius: 0.25rem; }
  .chiffres { font-variant-numeric: tabular-nums; }
  .visuellement-cache { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
