---
// Sous-pages de chaque pays : /<pays>/support/, /<pays>/privacy/, /<pays>/terms/, /<pays>/legal/ (mêmes noms dans toutes les langues).
import Base from "../../layouts/Base.astro";
import Support from "../../components/pages/Support.astro";
import Confidentialite from "../../components/pages/Confidentialite.astro";
import Mentions from "../../components/pages/Mentions.astro";
import Conditions from "../../components/pages/Conditions.astro";
import { t } from "../../lib/textes";
import { pays, type Pays } from "../../lib/pays";
import { sousPages, type SousPage } from "../../lib/liens";

export function getStaticPaths() {
  return pays.flatMap((p) => sousPages.map((page) => ({ params: { pays: p.code, page }, props: { p, page } })));
}
const { p, page } = Astro.props as { p: Pays; page: SousPage };
const l = p.langue;
const Contenu = { support: Support, privacy: Confidentialite, terms: Conditions, legal: Mentions }[page];
---
<Base langue={l} lang={p.code === "en" ? "en" : p.locale} titre={t(l, `pages.${page}.metaTitre`)} description={t(l, `pages.${page}.description`)} chemin={`${p.code}/${page}/`} codePays={p.code} alternatives={`${page}/`}>
  <Contenu p={p} />
</Base>
