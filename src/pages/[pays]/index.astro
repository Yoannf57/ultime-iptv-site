---
// Accueil, une page statique par pays (fr-fr, en-gb, en…). Sections dans l'ordre de CLAUDE.md, section 4.
import Base from "../../layouts/Base.astro";
import Entete from "../../components/accueil/Entete.astro";
import Heros from "../../components/accueil/Heros.astro";
import Fonctions from "../../components/accueil/Fonctions.astro";
import Visite from "../../components/accueil/Visite.astro";
import AppleTV from "../../components/accueil/AppleTV.astro";
import FamillePremium from "../../components/accueil/FamillePremium.astro";
import Etapes from "../../components/accueil/Etapes.astro";
import Tarifs from "../../components/accueil/Tarifs.astro";
import ViePrivee from "../../components/accueil/ViePrivee.astro";
import Faq from "../../components/accueil/Faq.astro";
import { t } from "../../lib/textes";
import { pays, type Pays } from "../../lib/pays";
import "../../styles/accueil.css";

export function getStaticPaths() {
  return pays.map((p) => ({ params: { pays: p.code }, props: { p } }));
}
const { p } = Astro.props as { p: Pays };
const l = p.langue;
---
<Base langue={l} lang={p.code === "en" ? "en" : p.locale} titre={t(l, "meta.titre")} description={t(l, "meta.description")} chemin={`${p.code}/`} codePays={p.code} alternatives>
  <Entete langue={l} lienAppStore={p.lienAppStore} />
  <main id="haut">
    <Heros langue={l} lienAppStore={p.lienAppStore} />
    <Fonctions langue={l} />
    <Visite langue={l} />
    <AppleTV langue={l} />
    <FamillePremium langue={l} />
    <Etapes langue={l} />
    <Tarifs langue={l} pays={p} />
    <ViePrivee langue={l} />
    <Faq langue={l} />
  </main>
</Base>

<script>
  import "../../scripts/onglets.js";
</script>
