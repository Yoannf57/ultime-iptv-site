---
// Page racine : devine le pays et y envoie le visiteur (CLAUDE.md, section 3).
// Sans JavaScript, elle EST la page « Choisissez votre pays ou votre région ».
import Base from "../layouts/Base.astro";
import ChoixPays from "../components/ChoixPays.astro";
import { t } from "../lib/textes";
import { paysPourNavigateur } from "../lib/pays";
import { base } from "../lib/liens";
import code from "../scripts/deviner-pays.js?raw";
import { editeurEtSite, jsonPourScript } from "../lib/jsonld";

const script = `${code}
(function () {
  var g = devinerPays(${JSON.stringify(paysPourNavigateur)});
  location.replace(${JSON.stringify(base)} + g.code + "/" + location.hash);
})();`;
// SEO : c'est la page d'accueil du domaine, celle que Google lit pour le nom du site. Titre de l'app (anglais) et
// données de l'éditeur et du site. Googlebot (anglais, fuseau américain) est ensuite renvoyé vers /en-us/.
const donnees = jsonPourScript({ "@context": "https://schema.org", "@graph": editeurEtSite(Astro.site!).graphe });
---
<Base langue="en" titre={t("en", "meta.titre")} description={t("en", "meta.description")} chemin="" languesPied={["fr", "en"]}>
  <script slot="tete" is:inline set:html={script}></script>
  <script slot="tete" type="application/ld+json" set:html={donnees} />
  <ChoixPays />
</Base>
