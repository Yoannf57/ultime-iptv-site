---
import config from "../../site.config.mjs";
import { googlePlayAffiche } from "../lib/googleplay";
import { t, langues as languesTextes } from "../lib/textes";
import { trouverPays, pays as tousPays, paysPourNavigateur } from "../lib/pays";
import code from "../scripts/deviner-pays.js?raw";
import { lien, lienSousPage, sousPages } from "../lib/liens";

interface Props { langue: string; codePays?: string; langues?: string[] }
// « langues » : sur les pages de choix (bilingues), les phrases obligatoires sont écrites dans chaque langue.
const { langue, codePays, langues = [langue] } = Astro.props;
const p = codePays ? trouverPays(codePays) : null;
// Liens Support · Confidentialité · Mentions légales : ceux du pays, ou la version internationale (en) sur les pages
// bilingues (choix du pays, 404).
const codeLiens = p ? p.code : "en";
const langueLiens = p ? langue : "en";
// Pages sans pays : un petit script remplace ces liens (et leurs libellés) par ceux du pays déjà choisi, sinon du
// pays deviné (langue du navigateur + fuseau horaire), sinon de la page internationale de la langue du visiteur.
// Sans JavaScript, les liens restent ceux de la version internationale en anglais.
// Les adresses sont fabriquées par le script (« modele ») : verifier-liens ne les voit pas ; chaque sous-page existe
// pour chaque pays (src/pages/[pays]/[page].astro).
const libelles = p ? {} : Object.fromEntries(languesTextes().map((l) => [l, {
  navigation: t(l, "pied.liens.navigation"),
  ...Object.fromEntries(sousPages.map((page) => [page, t(l, `pied.liens.${page}`)])),
}]));
const donnees = { liste: paysPourNavigateur, locales: Object.fromEntries(tousPays.map((x) => [x.code, x.locale])), libelles, modele: lienSousPage("CODE", "support").replace("support/", "PAGE/") };
const scriptLiens = p ? "" : `${code}
(function (d) {
  var nav = document.querySelector("[data-liens-pied]");
  if (!nav) return;
  var code = devinerPays(d.liste).code, langue = null;
  for (var i = 0; i < d.liste.length; i++) if (d.liste[i].code === code) langue = d.liste[i].langue;
  var mots = d.libelles[langue];
  if (!mots || code === "en") return;
  nav.lang = d.locales[code];
  nav.setAttribute("aria-label", mots.navigation);
  nav.querySelectorAll("a[data-page]").forEach(function (a) {
    var page = a.getAttribute("data-page");
    a.href = d.modele.replace("CODE", code).replace("PAGE", page);
    a.textContent = mots[page];
  });
})(${JSON.stringify(donnees).replace(/</g, "\\u003c")});`;
---
<footer class="pied">
  <div class="contenu">
    <div class="haut">
      <nav aria-label={t(langueLiens, "pied.liens.navigation")} lang={langueLiens} data-liens-pied={p ? undefined : ""}>
        <ul class="liens">
          {sousPages.map((page) => <li><a href={lienSousPage(codeLiens, page)} data-page={p ? undefined : page}>{t(langueLiens, `pied.liens.${page}`)}</a></li>)}
        </ul>
      </nav>
      {p && (
        <a class="globe" href={lien("pays/")} aria-label={t(langue, "pied.changerPays", { pays: p.nom, langue: p.nomLangue })}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="8" cy="8" r="6.5" /><path d="M1.5 8h13M8 1.5c2 2 2.8 4 2.8 6.5S10 12.5 8 14.5C6 12.5 5.2 10.5 5.2 8S6 3.5 8 1.5Z" /></svg>
          <span lang={p.locale}>{p.region === "international" ? p.nom : `${p.nom} · ${p.nomLangue}`}</span>
        </a>
      )}
    </div>
    {!p && <script is:inline set:html={scriptLiens}></script>}
    {langues.map((l) => (
      <p class="legal" lang={l}>{t(l, "neutralite")} {t(l, "pied.tmdb")} {t(l, "pied.marques")}{googlePlayAffiche && ` ${t(l, "pied.marquesGoogle")}`}</p>
    ))}
    <div class="bas">
      <img class="tmdb" src={lien("tmdb.svg")} alt={t(langue, "pied.tmdbLogo")} width="123" height="16" decoding="async" />
      <p>{t(langue, "pied.copyright")} · <a href={`mailto:${config.contact}`}>{config.contact}</a></p>
    </div>
  </div>
</footer>

<style>
  .pied { border-top: 1px solid #1c1c1e; background: #000; }
  .contenu { max-width: 75rem; margin: 0 auto; padding: 2.5rem 1.5rem 3rem; display: flex; flex-direction: column; gap: 1.5rem; font-size: 0.8125rem; color: #8e8e93; }
  .haut { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
  .liens { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  .liens a { text-decoration: none; }
  .liens a:hover { color: #f5f5f7; text-decoration: underline; }
  .globe { display: inline-flex; align-items: center; gap: 0.5rem; color: #f5f5f7; text-decoration: none; padding: 0.5rem 0.875rem; border: 1px solid #3a3a3e; border-radius: 999px; }
  .globe:hover { border-color: #8e8e93; }
  p { margin: 0; line-height: 1.6; }
  .bas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  /* Logo officiel TMDB (dégradé prévu pour fond sombre), plus petit que le logo Ulti. */
  .tmdb { display: block; height: 1rem; width: auto; flex: none; }
  a { color: #a1a1a6; }
</style>
