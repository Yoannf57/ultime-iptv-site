---
// Page « Choisissez votre pays ou votre région » (maquette Notes/maquette/Pays.dc.html) : pays regroupés par région,
// chaque nom écrit dans sa propre langue, langue en gris dessous. Ce sont de vrais liens : la page marche sans JavaScript.
// Le pays déjà choisi (localStorage « ultime-pays ») reçoit une coche et aria-current.
import { t, langues } from "../lib/textes";
import { pays, regions } from "../lib/pays";
import { lienPays } from "../lib/liens";
import Logo from "./Logo.astro";

const languesTitres = [...new Set(pays.map((p) => p.langue))].filter((l) => langues().includes(l));
function titresRegion(region: string) {
  return [...new Set(languesTitres.map((l) => t(l, `choix.regions.${region}`)))].join(" · ");
}
function paysDe(region: string) {
  return pays.filter((p) => p.region === region)
    .sort((a, b) => a.nom.localeCompare(b.nom, "fr") || a.nomLangue.localeCompare(b.nomLangue, "fr"));
}
---
<header class="entete">
  <div class="entete-interieur"><Logo langue={languesTitres[0]} /></div>
</header>
<main class="choix">
  <h1 lang={languesTitres[0]}>{t(languesTitres[0], "choix.titre")}</h1>
  {languesTitres.slice(1).map((l) => <p class="sous-titre" lang={l}>{t(l, "choix.titre")}</p>)}
  {regions.map((region) => (
    <section aria-labelledby={`region-${region}`}>
      <h2 id={`region-${region}`}>{titresRegion(region)}</h2>
      <ul>
        {paysDe(region).map((p) => (
          <li>
            <a href={lienPays(p.code)} hreflang={p.code === "en" ? "en" : p.locale} lang={p.locale} data-pays={p.code}>
              <span class="nom">{p.nom}<svg class="coche" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#F5F5F7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg></span>
              <span class="langue">{p.nomLangue}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</main>
<script is:inline>
  (function () {
    var choisi = null;
    try { choisi = localStorage.getItem("ultime-pays"); } catch (e) {}
    document.querySelectorAll("[data-pays]").forEach(function (a) {
      if (a.getAttribute("data-pays") === choisi) a.setAttribute("aria-current", "page");
      a.addEventListener("click", function () {
        try { localStorage.setItem("ultime-pays", a.getAttribute("data-pays")); } catch (e) {}
      });
    });
  })();
</script>

<style>
  .entete { border-bottom: 1px solid #1c1c1e; }
  .entete-interieur { max-width: 75rem; margin: 0 auto; padding: 0 1.5rem; height: 4rem; display: flex; align-items: center; }
  .choix { max-width: 75rem; width: 100%; margin: 0 auto; padding: 6rem 1.5rem 7.5rem; }
  h1 { margin: 0; font-size: clamp(2.25rem, 4.6vw, 3.75rem); line-height: 1.04; letter-spacing: -0.035em; font-weight: 800; }
  .sous-titre { margin: 0.875rem 0 0; font-size: 1.3125rem; color: #8e8e93; }
  section { margin-top: 4rem; }
  h2 { margin: 0 0 0.5rem; padding-bottom: 1rem; border-bottom: 1px solid #242428; font-size: 0.9375rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #a1a1a6; }
  ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; column-gap: 1rem; }
  li { flex: 0 1 17.5rem; min-width: 0; }
  a { display: flex; flex-direction: column; gap: 0.25rem; padding: 1rem 0.875rem; margin: 0 -0.875rem; border-radius: 0.875rem; text-decoration: none; color: #f5f5f7; }
  a:hover { background: #141416; }
  .nom { display: flex; align-items: center; gap: 0.625rem; font-size: 1.1875rem; font-weight: 600; }
  .coche { display: none; }
  a[aria-current="page"] .coche { display: block; }
  .langue { font-size: 0.9375rem; color: #8e8e93; }
</style>
