---
// Page « Choisissez votre pays ou votre région » (style Apple) : pays regroupés par région,
// chaque nom écrit dans sa propre langue. Ce sont de vrais liens : la page marche sans JavaScript.
import { t, langues } from "../lib/textes";
import { pays, regions } from "../lib/pays";
import { lienPays } from "../lib/liens";
import Logo from "./Logo.astro";

// Langues affichées dans les titres : celles des pays proposés, dans l'ordre de pays.json.
const languesTitres = [...new Set(pays.map((p) => p.langue))].filter((l) => langues().includes(l));
function titresRegion(region: string) {
  const vus = new Set<string>();
  return languesTitres
    .map((l) => ({ l, texte: t(l, `choix.regions.${region}`) }))
    .filter(({ texte }) => !vus.has(texte) && vus.add(texte));
}
---
<main class="choix">
  <div class="logo-haut"><Logo langue={languesTitres[0]} /></div>
  <h1>
    {languesTitres.map((l, i) => (
      <span lang={l} class:list={{ secondaire: i > 0 }}>{t(l, "choix.titre")}</span>
    ))}
  </h1>
  {regions.map((region) => (
    <section aria-labelledby={`region-${region}`}>
      <h2 id={`region-${region}`}>
        {titresRegion(region).map(({ l, texte }, i) => (
          <>{i > 0 && <span aria-hidden="true"> · </span>}<span lang={l}>{texte}</span></>
        ))}
      </h2>
      <ul>
        {pays.filter((p) => p.region === region).map((p) => (
          <li><a href={lienPays(p.code)} hreflang={p.code === "en" ? "en" : p.locale} lang={p.locale} data-pays={p.code}>{p.nom}</a></li>
        ))}
      </ul>
    </section>
  ))}
</main>
<script is:inline>
  document.querySelectorAll("[data-pays]").forEach(function (a) {
    a.addEventListener("click", function () {
      try { localStorage.setItem("ultime-pays", a.getAttribute("data-pays")); } catch (e) {}
    });
  });
</script>

<style>
  .choix { max-width: 61.25rem; width: 100%; margin: 0 auto; padding: 3rem 1.25rem 4rem; }
  .logo-haut { margin-bottom: 3rem; }
  h1 { margin: 0 0 3rem; font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.1; letter-spacing: -0.02em; display: grid; gap: 0.375rem; }
  h1 .secondaire { color: var(--texte-2); font-weight: 600; font-size: 0.6em; letter-spacing: -0.01em; }
  section { border-top: 1px solid var(--surface-2); padding: 1.5rem 0 2rem; }
  h2 { margin: 0 0 1rem; font-size: 1.0625rem; font-weight: 700; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(13.75rem, 1fr)); gap: 0.25rem 1.5rem; }
  a { display: block; padding: 0.5rem 0; text-decoration: none; color: var(--texte); font-size: 0.9375rem; }
  a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
</style>
