---
import { t } from "../../lib/textes";
interface Props { langue: string }
const { langue: l } = Astro.props;
// Motifs décoratifs des cartes (pas des écrans de l'app). Anneau rouge seulement pour une chaîne d'info.
const anneaux = [{ avance: 70, info: false }, { avance: 35, info: true }, { avance: 88, info: false }];
const anneau = (avance: number, info: boolean) => `conic-gradient(${info ? "#FF3B30" : "#F5F5F7"} 0 ${avance}%, #3A3A3E ${avance}% 100%)`;
const affiches = [
  { affiche: "SPRITE FRIGHT", fond: "#3D5A2A" }, { affiche: "SPRING", fond: "#2E5E7A" },
  { affiche: "CHARGE", fond: "#7A2E2E" }, { affiche: "COFFEE RUN", fond: "#6B4E2E" },
];
---
<section id="fonctions" aria-labelledby="titre-fonctions" class="section apparition">
  <h2 id="titre-fonctions" class="titre-section" style="max-width:18ch">{t(l, "fonctions.titre")}</h2>
  <p class="chapeau">{t(l, "fonctions.phrase")}</p>
  <div class="cartes">
    <article class="carte">
      <div class="motif ronds" aria-hidden="true">
        {anneaux.map((a) => <div class="rond" style={`background:${anneau(a.avance, a.info)}`}><div></div></div>)}
      </div>
      <h3>{t(l, "fonctions.directTitre")}</h3>
      <p>{t(l, "fonctions.directTexte")}</p>
    </article>
    <article class="carte">
      <div class="motif guide" aria-hidden="true">
        <div><span style="flex:3;background:#3a3a3e"></span><span style="flex:2"></span></div>
        <div><span style="flex:1"></span><span style="flex:4;background:#f5f5f7;opacity:0.85"></span></div>
        <div><span style="flex:2"></span><span style="flex:3;background:#3a3a3e"></span></div>
      </div>
      <h3>{t(l, "fonctions.guideTitre")}</h3>
      <p>{t(l, "fonctions.guideTexte")}</p>
    </article>
    <article class="carte">
      <div class="motif affiches" aria-hidden="true">
        {affiches.map((f) => <span style={`background:${f.fond}`}>{f.affiche}</span>)}
      </div>
      <h3>{t(l, "fonctions.filmsTitre")} <span class="premium">{t(l, "fonctions.premium")}</span></h3>
      <p>{t(l, "fonctions.filmsTexte")}</p>
    </article>
  </div>
</section>

<style>
  .cartes { margin-top: 3.5rem; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .carte { flex: 1 1 20rem; min-width: 0; padding: 2.25rem; display: flex; flex-direction: column; gap: 1rem; }
  h3 { margin: 0.5rem 0 0; font-size: 1.625rem; letter-spacing: -0.02em; font-weight: 700; }
  .carte p { margin: 0; font-size: 1.0625rem; line-height: 1.5; color: #a1a1a6; }
  .premium { display: inline-block; vertical-align: middle; margin-left: 0.375rem; font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #a1a1a6; border: 1px solid #3a3a3e; border-radius: 999px; padding: 0.1875rem 0.5625rem; }
  .ronds { display: flex; gap: 0.625rem; }
  .rond { width: 3.5rem; height: 3.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .rond div { width: 3rem; height: 3rem; border-radius: 50%; background: #141416; }
  .guide { display: flex; flex-direction: column; gap: 0.375rem; }
  .guide div { display: flex; gap: 0.375rem; }
  .guide span { height: 1.25rem; border-radius: 0.375rem; background: #242428; }
  .affiches { display: flex; gap: 0.5rem; }
  .affiches span { width: 3.375rem; height: 5rem; border-radius: 0.5rem; display: flex; align-items: flex-end; padding: 0.375rem; font-size: 0.5625rem; line-height: 1.1; font-weight: 800; color: #fff; letter-spacing: 0.02em; }
</style>
