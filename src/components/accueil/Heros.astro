---
import config from "../../../site.config.mjs";
import { t } from "../../lib/textes";
import { captures } from "../../lib/captures";
import Capture from "./Capture.astro";
import Cadre from "./Cadre.astro";
import Halo from "./Halo.astro";
import Zones from "./Zones.astro";
import BoutonLecture from "./BoutonLecture.astro";
import BadgeAppStore from "./BadgeAppStore.astro";
import type { Pays } from "../../lib/pays";
interface Props { langue: string; p: Pays }
const { langue: l, p } = Astro.props;
// Petite ligne sous le badge : « Bientôt sur Android. », ou avec l'Apple TV quand l'app est publiée sans elle.
// Avant la publication, sous « Bientôt sur l'App Store » : « Puis sur Android. » (évite deux « Bientôt » de suite).
const ligneAndroid = !config.disponible ? "heros.androidAvantPublication"
  : config.appleTvDisponible ? "heros.android" : "heros.androidSansAppleTv";
const { vues, ecrans } = captures.apercu;
// Apple TV au centre (écran flottant), iPhone devant à droite dans son cadre officiel. Tailles d'affichage pour « sizes ».
const tailleTv = "(max-width: 45rem) 92vw, min(78vw, 58rem)";
const tailleTel = "min(15vw, 11rem)";
---
<section aria-labelledby="titre-principal" class="haut">
  <p class="surtitre">{t(l, "heros.surtitre")}</p>
  <h1 id="titre-principal">{t(l, "heros.accroche")}</h1>
  <p class="phrase">{t(l, "heros.phrase")}</p>
  <div class="boutons">
    {config.disponible
      ? <BadgeAppStore langue={l} p={p} />
      : <span class="bouton plein bientot">{t(l, "heros.bientot")}</span>}
    <a class="bouton contour" href="#tarifs">{t(l, "heros.voirTarifs")}</a>
  </div>
  <p class="android">{t(l, ligneAndroid)}</p>
  <p class="neutre">{t(l, "heros.neutralite")}</p>
</section>

<section aria-label={t(l, "apercu.etiquette")} class="apercu">
  <!-- Les écrans défilent seuls (visite.js), comme la visite iPad ; onglets dessinés cliquables sur l'Apple TV. -->
  <!-- data-seuil : au chargement, seul le haut du grand visuel est visible sous le titre ; il défile déjà. -->
  <div class="demo" data-visite data-seuil="0.1">
    <!-- Pastilles au-dessus des appareils, juste sous la phrase de neutralité (demande de Yoann, 08/11/2026). -->
    <div class="commandes avec-js">
      <div class="pastilles" role="group" aria-label={t(l, "apercu.onglets")}>
        {vues.map((v, i) => (
          <button type="button" data-onglet={v} aria-pressed={i === 0 ? "true" : "false"}>{t(l, `onglets.${v}`)}<span class="barre" aria-hidden="true"></span></button>
        ))}
      </div>
      <BoutonLecture langue={l} />
    </div>
    <div class="scene">
      <Halo etendue="large" />
      <div class="ecrin-tv tv pile">
        {vues.map((v, i) => (
          <div class:list={["diapo", { active: i === 0 }]} data-diapo={v} hidden={i > 0}>
            <Capture langue={l} appareil="appletv" capture={ecrans.appletv[v]} sizes={tailleTv} prioritaire={i === 0} />
            <Zones langue={l} appareil="appletv" capture={ecrans.appletv[v]} vues={vues} />
          </div>
        ))}
      </div>
      <Cadre appareil="iphone" sizes={tailleTel} classe="telephone">
        {vues.map((v, i) => (
          <div class:list={["diapo", { active: i === 0 }]} data-diapo={v} hidden={i > 0}>
            <Capture langue={l} appareil="iphone" capture={ecrans.iphone[v]} sizes={tailleTel} />
          </div>
        ))}
      </Cadre>
    </div>
    <p class="appareils">{t(l, "apercu.appareils")}</p>
    <p class="indice avec-js">{t(l, "apercu.indice")}</p>
  </div>
</section>

<style>
  .haut { max-width: 75rem; margin: 0 auto; padding: 6.5rem 1.5rem 2.5rem; text-align: center; }
  .surtitre { margin: 0 0 1.25rem; font-size: 1.0625rem; font-weight: 600; color: #fff; }
  h1 { margin: 0 auto; max-width: 15ch; font-size: clamp(3rem, 7.4vw, 6.5rem); line-height: 0.98; letter-spacing: -0.045em; font-weight: 800; white-space: pre-line; }
  .phrase { margin: 1.75rem auto 0; max-width: 40rem; font-size: clamp(1.125rem, 1.8vw, 1.375rem); line-height: 1.45; color: #a1a1a6; }
  .boutons { margin-top: 2.25rem; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem; }
  /* Même hauteur que le badge officiel (3 rem, 2,75 rem sur téléphone). */
  .bouton { display: inline-flex; align-items: center; height: 3rem; padding: 0 1.75rem; border-radius: 999px; font-size: 1.0625rem; font-weight: 600; text-decoration: none; }
  .plein { background: #f5f5f7; color: #000; }
  .bientot { opacity: 0.92; }
  .contour { color: #f5f5f7; border: 1px solid #3a3a3e; }
  .contour:hover { border-color: #8e8e93; }
  .android { margin: 1rem 0 0; font-size: 0.875rem; color: #8e8e93; }
  .neutre { margin: 1.25rem 0 0; font-size: 0.8125rem; color: #8e8e93; }

  .apercu { max-width: 75rem; margin: 0 auto; padding: 0.5rem 1.5rem 7.5rem; }
  /* L'iPhone (≈ 15 % de la scène) chevauche le coin bas droit de l'Apple TV, sans rien couper. */
  .scene { position: relative; padding: 0 7% 10% 3%; }
  .scene :global(.telephone) { position: absolute; z-index: 2; right: 0; bottom: 0; width: 15%; }
  .appareils { margin: 2.25rem 0 0; text-align: center; font-size: 0.9375rem; color: #a1a1a6; }
  /* Au-dessus du halo, pour que les pastilles gardent leurs vraies couleurs. */
  .commandes { position: relative; z-index: 3; margin: 0 0 2.5rem; }
  .indice { margin: 1rem 0 0; text-align: center; font-size: 0.875rem; color: #8e8e93; }

  @media (max-width: 45rem) {
    /* Sur téléphone, l'iPhone ferait moins de 200 px de haut (règle d'Apple) : masqué, seule l'Apple TV reste. */
    .bouton { height: 2.75rem; }
    .scene { padding: 0; }
    .scene :global(.telephone) { display: none; }
  }
</style>
