---
import config from "../../../site.config.mjs";
import { t } from "../../lib/textes";
import { captures, type Appareil } from "../../lib/captures";
import Capture from "./Capture.astro";
import Halo from "./Halo.astro";
interface Props { langue: string; lienAppStore: string | null }
const { langue: l, lienAppStore } = Astro.props;
const { vues, ecrans } = captures.apercu;
// Apple TV au centre, iPad devant à gauche, iPhone devant à droite. Tailles d'affichage pour « sizes ».
const appareils: { appareil: Appareil; classe: string; sizes: string }[] = [
  { appareil: "appletv", classe: "ecrin-tv tv", sizes: "(max-width: 45rem) 92vw, min(82vw, 61.5rem)" },
  { appareil: "ipad", classe: "ecrin-ipad ipad", sizes: "min(30vw, 22rem)" },
  { appareil: "iphone", classe: "ecrin-tel iphone", sizes: "min(14vw, 10rem)" },
];
---
<section aria-labelledby="titre-principal" class="haut">
  <p class="surtitre">{t(l, "heros.surtitre")}</p>
  <h1 id="titre-principal">{t(l, "heros.accroche")}</h1>
  <p class="phrase">{t(l, "heros.phrase")}</p>
  <div class="boutons">
    {config.disponible && lienAppStore
      ? <a class="bouton plein" href={lienAppStore}>{t(l, "heros.telecharger")}</a>
      : <span class="bouton plein bientot">{t(l, "heros.bientot")}</span>}
    <a class="bouton contour" href="#tarifs">{t(l, "heros.voirTarifs")}</a>
  </div>
  <p class="neutre">{t(l, "heros.neutralite")}</p>
</section>

<section aria-label={t(l, "apercu.etiquette")} class="apercu">
  <div class="scene">
    <Halo etendue="large" />
    {appareils.map(({ appareil, classe, sizes }) => (
      <div class={classe} data-ecran="apercu">
        {vues.map((v, i) => (
          <div class="vue" data-vue={v} hidden={i > 0}>
            <Capture langue={l} appareil={appareil} capture={ecrans[appareil][v]} sizes={sizes} prioritaire={i === 0 && appareil === "appletv"} differee={i > 0} />
          </div>
        ))}
      </div>
    ))}
  </div>
  <p class="appareils">{t(l, "apercu.appareils")}</p>
  <div class="pastilles avec-js" role="group" aria-label={t(l, "apercu.onglets")}>
    {vues.map((v, i) => (
      <button type="button" data-cible="apercu" data-vue={v} aria-pressed={i === 0 ? "true" : "false"}>{t(l, `onglets.${v}`)}</button>
    ))}
  </div>
  <p class="indice avec-js">{t(l, "apercu.indice")}</p>
</section>

<style>
  .haut { max-width: 75rem; margin: 0 auto; padding: 6.5rem 1.5rem 2.5rem; text-align: center; }
  .surtitre { margin: 0 0 1.25rem; font-size: 1.0625rem; font-weight: 600; color: #fff; }
  h1 { margin: 0 auto; max-width: 15ch; font-size: clamp(3rem, 7.4vw, 6.5rem); line-height: 0.98; letter-spacing: -0.045em; font-weight: 800; white-space: pre-line; }
  .phrase { margin: 1.75rem auto 0; max-width: 40rem; font-size: clamp(1.125rem, 1.8vw, 1.375rem); line-height: 1.45; color: #a1a1a6; }
  .boutons { margin-top: 2.25rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .bouton { display: inline-flex; align-items: center; padding: 0.9375rem 1.75rem; border-radius: 999px; font-size: 1.0625rem; font-weight: 600; text-decoration: none; }
  .plein { background: #f5f5f7; color: #000; }
  .bientot { opacity: 0.92; }
  .contour { color: #f5f5f7; border: 1px solid #3a3a3e; }
  .contour:hover { border-color: #8e8e93; }
  .neutre { margin: 1.25rem 0 0; font-size: 0.8125rem; color: #8e8e93; }

  .apercu { max-width: 75rem; margin: 0 auto; padding: 2.5rem 1.5rem 7.5rem; }
  .scene { position: relative; padding: 0 9% 9%; }
  .ipad { position: absolute; z-index: 2; left: 0; bottom: 0; width: 30%; }
  .iphone { position: absolute; z-index: 3; right: 0; bottom: 0; width: 14%; }
  .appareils { margin: 2.25rem 0 0; text-align: center; font-size: 0.9375rem; color: #a1a1a6; }
  .pastilles { margin-top: 1.25rem; }
  .indice { margin: 1rem 0 0; text-align: center; font-size: 0.875rem; color: #8e8e93; }

  @media (max-width: 45rem) {
    .scene { padding: 0; }
    .ipad, .iphone { display: none; }
  }
</style>
