---
import config from "../../../site.config.mjs";
import { t } from "../../lib/textes";
import { ecrans } from "../../lib/ecrans";
import EcranTV from "./EcranTV.astro";
import EcranTel from "./EcranTel.astro";
import Halo from "./Halo.astro";
interface Props { langue: string; lienAppStore: string | null }
const { langue: l, lienAppStore } = Astro.props;
---
<section aria-labelledby="titre-principal" class="haut">
  <p class="surtitre">{t(l, "heros.surtitre")}</p>
  <h1 id="titre-principal">{t(l, "heros.accroche")}</h1>
  <p class="phrase">{t(l, "heros.phrase")}</p>
  <div class="boutons">
    {config.disponible && lienAppStore
      ? <a class="bouton plein" href={lienAppStore}>{t(l, "heros.telecharger")}</a>
      : <span class="bouton plein bientot">{t(l, "heros.bientot")}</span>}
    <a class="bouton contour" href="#tarifs">{t(l, "heros.voirTarifs")}</a>
  </div>
  <p class="neutre">{t(l, "heros.neutralite")}</p>
</section>

<section aria-label={t(l, "apercu.etiquette")} class="apercu">
  <div class="scene">
    <Halo etendue="large" />
    <div class="ecrin-tv">
      <EcranTV langue={l} id="tv" vues={["accueil", "direct", "replay", "films", "series"]} barre />
    </div>
    <div class="telephone ecrin-tel">
      <EcranTel langue={l} id="tel" />
    </div>
  </div>
  <div class="pastilles avec-js" role="group" aria-label={t(l, "apercu.ongletsTV")}>
    {ecrans.ongletsTV.map((o, i) => (
      <button type="button" data-cible="tv" data-vue={o} aria-pressed={i === 0 ? "true" : "false"}>{t(l, `onglets.${o}`)}</button>
    ))}
  </div>
  <p class="indice avec-js">
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 2.5 13 7.2 8.6 8.6 7.2 13Z" /></svg>
    {t(l, "apercu.indice")}
  </p>
</section>

<style>
  .haut { max-width: 75rem; margin: 0 auto; padding: 6.5rem 1.5rem 2.5rem; text-align: center; }
  .surtitre { margin: 0 0 1.25rem; font-size: 1.0625rem; font-weight: 600; color: #fff; }
  h1 { margin: 0 auto; max-width: 15ch; font-size: clamp(3rem, 7.4vw, 6.5rem); line-height: 0.98; letter-spacing: -0.045em; font-weight: 800; white-space: pre-line; }
  .phrase { margin: 1.75rem auto 0; max-width: 40rem; font-size: clamp(1.125rem, 1.8vw, 1.375rem); line-height: 1.45; color: #a1a1a6; }
  .boutons { margin-top: 2.25rem; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; }
  .bouton { display: inline-flex; align-items: center; padding: 0.9375rem 1.75rem; border-radius: 999px; font-size: 1.0625rem; font-weight: 600; text-decoration: none; }
  .plein { background: #f5f5f7; color: #000; }
  .bientot { opacity: 0.92; }
  .contour { color: #f5f5f7; border: 1px solid #3a3a3e; }
  .contour:hover { border-color: #8e8e93; }
  .neutre { margin: 1.25rem 0 0; font-size: 0.8125rem; color: #8e8e93; }

  .apercu { max-width: 75rem; margin: 0 auto; padding: 2.5rem 1.5rem 7.5rem; }
  .scene { position: relative; padding: 0 6% 7% 0; }
  .telephone { position: absolute; z-index: 2; right: 0; bottom: 0; width: 22%; }
  .pastilles { display: none; }
  .indice { margin: 1.75rem 0 0; text-align: center; font-size: 0.875rem; color: #8e8e93; display: flex; justify-content: center; align-items: center; gap: 0.5rem; }

  @media (max-width: 45rem) {
    .scene { padding: 0; }
    .telephone { display: none; }
    /* Sur téléphone, les onglets dessinés dans la télé sont trop petits pour le doigt : rangée de pastilles lisibles. */
    .pastilles { margin: 1.25rem auto 0; display: flex; flex-wrap: nowrap; justify-content: center; gap: 0.125rem; padding: 0.25rem; border-radius: 999px; background: #141416; width: fit-content; max-width: 100%; }
    .pastilles button { border: 0; cursor: pointer; padding: 0.5rem 0.625rem; min-height: 2.75rem; border-radius: 999px; font: inherit; font-size: 0.8125rem; white-space: nowrap; font-weight: 600; background: transparent; color: #d1d1d6; }
    .pastilles button[aria-pressed="true"] { background: #f5f5f7; color: #000; }
    .indice { margin-top: 1rem; }
  }
</style>
