---
import { t } from "../../lib/textes";
import config from "../../../site.config.mjs";
import { googlePlayAffiche } from "../../lib/googleplay";
import { lienSousPage } from "../../lib/liens";
import type { Offre } from "../../lib/offre";
interface Props { langue: string; codePays: string; offre?: Offre | null }
const { langue: l, codePays, offre = null } = Astro.props;
// « Sur quels appareils ? » (r2) : autre réponse si l'app est publiée sans la version Apple TV.
// Sans Google Play (googlePlayAffiche false) : l'ancienne réponse, « version Android en préparation ».
const reponse = (n: number) => n !== 2 ? `faq.r${n}`
  : `faq.r2${config.disponible && !config.appleTvDisponible ? "SansAppleTv" : ""}${googlePlayAffiche ? "" : "SansGooglePlay"}`;
---
<section id="questions" aria-labelledby="titre-questions" class="faq apparition">
  <h2 id="titre-questions">{t(l, "faq.titre")}</h2>
  {[1, 2, 3, 4, 5].map((n) => (
    <details open={n === 1} class:list={{ "derniere-normale": offre && n === 5 }}>
      <summary>{t(l, `faq.q${n}`)}<span class="plus" aria-hidden="true">+</span></summary>
      <p>{t(l, reponse(n))}</p>
    </details>
  ))}
  {/* Black Friday : une question de plus, seulement jusqu'à la date de fin. */}
  {offre && (
    <details class="bf-offre">
      <summary>{t(l, "offre.faqQ")}<span class="plus" aria-hidden="true">+</span></summary>
      <p class="chiffres">{offre.prix
        ? t(l, offre.prixDunAn ? "offre.faqR" : "offre.faqRSansArgument", { date: offre.date, prix: offre.prix.solo.reduit, prixFamille: offre.prix.famille.reduit })
        : t(l, "offre.faqRSansPrix", { date: offre.date })}
        {/* Google Play (27/11/2026) : à vie Solo aussi en promo sur Google Play ; Famille seulement sur Apple. */}
        {config.blackFriday.aussiGooglePlay && googlePlayAffiche && ` ${t(l, offre.prix ? "offre.googlePlay" : "offre.googlePlaySansPrix")}`}</p>
    </details>
  )}
  <p class="plus-de-questions"><a href={lienSousPage(codePays, "support")}>{t(l, "faqPlus")} <span aria-hidden="true">→</span></a></p>
</section>

<style>
  .faq { max-width: 53.75rem; margin: 0 auto; padding: 0 1.5rem 7.5rem; }
  h2 { margin: 0 0 2rem; font-size: clamp(2rem, 3.6vw, 3rem); letter-spacing: -0.03em; font-weight: 800; }
  details { border-top: 1px solid #242428; padding: 1.375rem 0; }
  details:last-of-type { border-bottom: 1px solid #242428; }
  /* Hors Black Friday, la question de l'offre est cachée : la 5ᵉ redevient la dernière. */
  :global(html:not(.bf)) details.derniere-normale { border-bottom: 1px solid #242428; }
  summary { cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 1.5rem; font-size: 1.25rem; font-weight: 600; }
  summary::-webkit-details-marker { display: none; }
  .plus { color: #8e8e93; font-size: 1.625rem; line-height: 1; transition: transform 0.2s; }
  details[open] .plus { transform: rotate(45deg); }
  .plus-de-questions { margin-top: 2rem; }
  .plus-de-questions a { color: #f5f5f7; font-weight: 600; }
  p { margin: 0.875rem 0 0; font-size: 1.0625rem; line-height: 1.55; color: #a1a1a6; }
</style>
