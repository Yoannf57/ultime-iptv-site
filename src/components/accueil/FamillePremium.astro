---
import { t } from "../../lib/textes";
import { captures } from "../../lib/captures";
import Capture from "./Capture.astro";
interface Props { langue: string }
const { langue: l } = Astro.props;
const { appareil, capture } = captures.famille;
const lignes = ["films", "multi", "pause", "replay", "telechargements", "icloud", "plusieurs", "themes"];
---
<section aria-labelledby="titre-famille" class="section deux apparition">
  <article class="carte">
    <h2 id="titre-famille">{t(l, "famille.titre")}</h2>
    <p class="gris texte">{t(l, "famille.texte")}</p>
    <div class="ecrin-tv profils">
      <Capture langue={l} appareil={appareil} capture={capture} sizes="(max-width: 64rem) 88vw, 32rem" />
    </div>
  </article>
  <article class="carte" aria-labelledby="titre-premium">
    <p class="etiquette">{t(l, "premium.surtitre")}</p>
    <h2 id="titre-premium" class="avec-etiquette">{t(l, "premium.titre")}</h2>
    <ul>
      {lignes.map((c) => <li>{t(l, `premium.${c}`)}</li>)}
    </ul>
  </article>
</section>

<style>
  .deux { padding-top: 7.5rem; display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .carte { flex: 1 1 28.75rem; min-width: 0; padding: 2.75rem; }
  h2 { margin: 0; font-size: clamp(1.875rem, 3.2vw, 2.75rem); line-height: 1.05; letter-spacing: -0.03em; font-weight: 800; }
  h2.avec-etiquette { margin-top: 0.75rem; }
  .texte { margin: 1.125rem 0 0; font-size: 1.0625rem; line-height: 1.5; }
  .profils { margin-top: 2rem; border-radius: 1rem; }
  .etiquette { margin: 0; font-size: 1.0625rem; font-weight: 600; color: #fff; }
  ul { margin: 1.75rem 0 0; padding: 0; list-style: none; font-size: 1.0625rem; }
  li { padding: 0.875rem 0; border-top: 1px solid #242428; }
  li:last-child { border-bottom: 1px solid #242428; }
</style>
