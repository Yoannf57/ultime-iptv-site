---
// Tarifs (CLAUDE.md, section 6) : carte Gratuit, puis choix « Pour moi » / « Pour la famille » au-dessus des offres
// payantes. Sans JavaScript, les deux formules s'affichent l'une sous l'autre. Prix pris dans pays.json, jamais convertis.
import { t } from "../../lib/textes";
import { formaterPrix, type Pays } from "../../lib/pays";
interface Props { langue: string; pays: Pays }
const { langue: l, pays: p } = Astro.props;
const formules = [
  { id: "solo", bouton: "tarifs.pourMoi", legende: "tarifs.soloLegende" },
  { id: "famille", bouton: "tarifs.pourFamille", legende: "tarifs.familleLegende" },
] as const;
const zero = p.devise ? formaterPrix(0, p) : "0";
function cartes(id: "solo" | "famille") {
  const prix = p.prix?.[id];
  const montant = (v?: number) => (v === undefined ? null : formaterPrix(v, p));
  return [
    { titre: t(l, "tarifs.mensuel"), montant: montant(prix?.mensuel), unite: t(l, "tarifs.parMois"), texte: t(l, "tarifs.mensuelTexte") },
    { titre: t(l, "tarifs.annuel"), montant: montant(prix?.annuel), unite: t(l, "tarifs.parAn"), mis: true,
      remise: prix?.remise !== undefined && t(l, "tarifs.remise", { remise: String(prix.remise) }),
      texte: prix?.annuelParMois !== undefined ? t(l, "tarifs.annuelTexte", { prix: formaterPrix(prix.annuelParMois, p) }) : t(l, "tarifs.annuelTexteSansPrix") },
    { titre: t(l, "tarifs.vie"), montant: montant(prix?.vie), unite: "", texte: t(l, "tarifs.vieTexte") },
  ];
}
---
<section id="tarifs" aria-labelledby="titre-tarifs" class="section apparition">
  <h2 id="titre-tarifs" class="titre-section centre">{t(l, "tarifs.titre")}</h2>
  <p class="chapeau centre">{t(l, "tarifs.phrase")}</p>
  <div class="choix-bloc avec-js" data-groupe="formule-legende">
    <div class="choix" role="group" aria-label={t(l, "tarifs.choix")}>
      {formules.map((f, i) => <button type="button" data-cible="formule" data-vue={f.id} aria-pressed={i === 0 ? "true" : "false"}>{t(l, f.bouton)}</button>)}
    </div>
    {formules.map((f, i) => <p class="legende" data-legende={f.id} hidden={i > 0}>{t(l, f.legende)}</p>)}
  </div>
  <div class="grille">
    <article class="carte offre gratuit">
      <h3>{t(l, "tarifs.gratuitTitre")}</h3>
      <p class="montant chiffres">{zero}</p>
      <p class="detail">{t(l, "tarifs.gratuitTexte")}</p>
    </article>
    <div class="payant">
      <div data-groupe="formule" class="panneaux">
        {formules.map((f, i) => (
          <div class="formule" data-panneau={f.id} hidden={i > 0}>
            <p class="legende sans-js">{t(l, f.bouton)} · {t(l, f.legende)}</p>
            <div class="trois">
              {cartes(f.id).map((c) => (
                <article class:list={["carte", "offre", { mis: c.mis }]}>
                  <div class="ligne-titre">
                    <h3>{c.titre}</h3>
                    {c.remise && <span class="remise chiffres">{c.remise}</span>}
                  </div>
                  {c.montant
                    ? <p class="montant chiffres"><span class="somme">{c.montant}</span>{c.unite && <span class="unite"> {c.unite}</span>}</p>
                    : <p class="montant-absent">{t(l, "tarifs.prixAppStore")}</p>}
                  <p class="detail">{c.texte}</p>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
  <p class="memes">{t(l, "tarifs.memesFonctions")}</p>
  <p class="note">{p.prix && `${t(l, p.taxesEnSus ? "tarifs.noteHT" : "tarifs.noteTTC")} `}{t(l, "tarifs.noteAppStore")}</p>
</section>

<style>
  .centre { text-align: center; margin-left: auto; margin-right: auto; }
  .chapeau.centre { margin-top: 1.125rem; max-width: 36rem; }
  .choix-bloc { margin-top: 2.5rem; text-align: center; }
  .grille { margin-top: 2rem; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 1rem; align-items: stretch; }
  :global(html:not(.js)) .grille { margin-top: 3.5rem; align-items: start; }
  .payant, .panneaux { min-width: 0; }
  /* Cartes de même hauteur : seulement quand une seule formule est affichée (avec JavaScript). */
  :global(html.js) .payant, :global(html.js) .panneaux, :global(html.js) .formule, :global(html.js) .trois { height: 100%; }
  .choix { margin: 0 auto; display: flex; gap: 0.375rem; padding: 0.375rem; border-radius: 999px; background: #141416; width: fit-content; }
  .choix button { border: 0; cursor: pointer; padding: 0.5625rem 1.25rem; border-radius: 999px; font: inherit; font-size: 0.9375rem; font-weight: 600; background: transparent; color: #d1d1d6; }
  .choix button[aria-pressed="true"] { background: #f5f5f7; color: #000; }
  .legende { margin: 1rem 0 0; text-align: center; font-size: 0.9375rem; color: #a1a1a6; }
  .legende[hidden] { display: none; }
  .formule[hidden] { display: none; }
  :global(html:not(.js)) .formule[hidden] { display: block; }
  .formule.entree { animation: fondu 0.2s ease-out; }
  :global(html:not(.js)) .formule + .formule { margin-top: 1.5rem; }
  .formule .legende { margin: 0 0 1rem; }
  @keyframes fondu { from { opacity: 0; } to { opacity: 1; } }
  .trois { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .offre { border-radius: 1.5rem; padding: 2rem; display: flex; flex-direction: column; gap: 0.5rem; }
  .offre.mis { border: 2px solid #fff; padding: 1.875rem; }
  .ligne-titre { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; }
  h3 { margin: 0; font-size: 1.1875rem; font-weight: 700; }
  .remise { font-size: 0.8125rem; font-weight: 700; background: #fff; color: #000; padding: 0.25rem 0.625rem; border-radius: 999px; white-space: nowrap; }
  /* Montant et unité : l'unité passe à la ligne si la place manque (ex. « 20.00 CHF / an »). */
  .montant { margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0.3rem; font-size: clamp(2rem, 2.9vw, 2.75rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .somme { white-space: nowrap; }
  .unite { white-space: nowrap; }
  .unite { font-size: 1.0625rem; font-weight: 600; color: #a1a1a6; letter-spacing: 0; }
  .montant-absent { margin: 0.5rem 0 0; font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
  .detail { margin: 0; font-size: 0.9375rem; line-height: 1.5; color: #a1a1a6; }
  .memes { margin: 1.5rem 0 0; text-align: center; font-size: 0.9375rem; color: #c7c7cc; }
  .note { margin: 0.5rem 0 0; text-align: center; font-size: 0.8125rem; color: #8e8e93; }
  @media (max-width: 68rem) {
    .grille { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 45rem) { .trois { grid-template-columns: minmax(0, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .formule.entree { animation: none; } }
</style>
