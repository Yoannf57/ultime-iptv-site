---
// Section « Connexion » (juste après le grand visuel) : grand titre à gauche, puis deux appareils côte à côte,
// chacun avec son texte dessous : à gauche « Collez. C'est tout. », à droite « Scannez. C'est tout. » (écran
// d'appairage de l'Apple TV par QR code, CollezTv.astro ; demande de Yoann, 08/11/2026).
// Côté téléphone : coller le message du fournisseur suffit. Un téléphone
// flottant (coins arrondis, liseré blanc très fin, pas de cadre d'Apple : ce n'est pas une capture) enchaîne
// 4 tableaux avec visite.js : message → « Coller le message reçu » → champs remplis → vraie capture de l'accueil.
// Étiquettes cliquables, Pause/Lecture, pause au survol. Sans JavaScript ou avec « réduire les animations » :
// les 4 tableaux côte à côte, figés. Dessous, les 3 étapes (ancienne section « Prêt en une minute »).
// Vocabulaire : ni « M3U » ni « Xtream » dans cette section (CLAUDE.md, section 4).
import { t } from "../../lib/textes";
import Halo from "./Halo.astro";
import BoutonLecture from "./BoutonLecture.astro";
import CollezEcran from "./CollezEcran.astro";
import CollezTv from "./CollezTv.astro";
interface Props { langue: string }
const { langue: l } = Astro.props;
const vues = ["message", "coller", "remplir", "pret"];
// 2,6 + 2,2 + 3,2 s, puis le dernier tableau reste 2,5 s + 2 s de pause avant de recommencer.
const durees = "2600,2200,3200,4500";
const legende = (vue: string) => t(l, `collez.legendes.${vue}`, { bouton: t(l, "collez.app.coller") });
---
<section id="collez" aria-labelledby="titre-collez" class="section collez apparition">
  <div class="tete">
    <p class="surtitre">{t(l, "collez.surtitre")}</p>
    <h2 id="titre-collez" class="titre-section">{t(l, "collez.titre")}</h2>
  </div>

  <div class="duo">
    <div class="appareil-tel">
      <div class="demo avec-js" data-visite data-enchainer data-durees={durees} data-seuil="0.5">
        <div class="scene">
          <Halo />
          <div class="telephone">
            <div class="ecran">
              {vues.map((vue, i) => (
                <div class:list={["diapo", { active: i === 0 }]} data-diapo={vue} hidden={i > 0}>
                  <CollezEcran langue={l} tableau={vue} />
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="commandes">
          <div class="pastilles onglets" role="group" aria-label={t(l, "collez.groupe")}>
            {vues.map((vue, i) => (
              <button type="button" data-onglet={vue} aria-pressed={i === 0 ? "true" : "false"}>
                {t(l, `collez.etiquettes.${vue}`)}<span class="barre" aria-hidden="true"></span>
              </button>
            ))}
          </div>
          <BoutonLecture langue={l} />
        </div>
        <div class="legendes" data-legendes aria-live="off">
          {vues.map((vue, i) => (
            <p class:list={["legende", { active: i === 0 }]} data-legende={vue}>{legende(vue)}</p>
          ))}
        </div>
      </div>

      <ol class="grille sans-js fige">
        {vues.map((vue, i) => (
          <li>
            <div class="telephone"><div class="ecran"><CollezEcran langue={l} tableau={vue} /></div></div>
            <p class="legende"><span class="numero chiffres">{i + 1}. {t(l, `collez.etiquettes.${vue}`)}</span>{legende(vue)}</p>
          </li>
        ))}
      </ol>
    </div>
    <div class="texte-tel">
      <h3>{t(l, "collez.collerTitre")}</h3>
      <p>{t(l, "collez.phrase")}</p>
    </div>

    <div class="appareil-tv">
      <div class="scene-tv">
        <Halo />
        <div class="ecran-tv"><CollezTv langue={l} /></div>
      </div>
    </div>
    <div class="texte-tv">
      <h3>{t(l, "collez.scannerTitre")}</h3>
      <p>{t(l, "collez.scannerPhrase")}</p>
    </div>
  </div>

  <ol class="etapes">
    {[1, 2, 3].map((n) => (
      <li>
        <h3><span class="numero chiffres" aria-hidden="true">{String(n).padStart(2, "0")}</span>{t(l, `etapes.e${n}Titre`)}</h3>
        <p>{t(l, `etapes.e${n}Texte`)}</p>
      </li>
    ))}
  </ol>
  <p class="minute">{t(l, "collez.minute")}</p>
</section>

<style is:global>
  /* Mise en page sur ordinateur : grand titre à gauche, puis deux rangées en miroir, téléphone puis son texte,
     texte puis l'Apple TV (plus large). Sur téléphone : chaque appareil, puis son texte dessous. */
  .collez .tete { max-width: 46rem; }
  .collez .surtitre { color: #a1a1a6; }
  .collez .duo { margin-top: 4rem; display: grid; grid-template-columns: minmax(0, 28rem) minmax(0, 1fr); grid-template-areas: "tel ttel" "ttv tv"; gap: 6rem 5rem; align-items: center; }
  .collez .appareil-tel { grid-area: tel; }
  .collez .appareil-tv { grid-area: tv; }
  .collez .texte-tel { grid-area: ttel; }
  .collez .texte-tv { grid-area: ttv; }
  .collez .duo h3 { margin: 0; font-size: clamp(1.5rem, 3.2vw, 2.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.1; }
  .collez .duo h3 + p { margin: 1rem 0 0; max-width: 30rem; font-size: clamp(1.0625rem, 1.4vw, 1.1875rem); line-height: 1.55; color: #a1a1a6; }
  .collez .demo { display: flex; flex-direction: column; align-items: center; }
  .collez .scene { position: relative; width: min(100%, 18.5rem); }
  .collez .scene .halo { left: -40%; right: -40%; }

  /* Apple TV : écran flottant 16:9, même liseré et même ombre que le téléphone. */
  .collez .scene-tv { position: relative; }
  .collez .ecran-tv { position: relative; z-index: 1; container-type: inline-size; aspect-ratio: 16 / 9; overflow: hidden; background: #000; border-radius: 1.5cqw; box-shadow: 0 0 0 1px rgba(255,255,255,0.16), 0 2.5rem 7.5rem rgba(0,0,0,0.9); }
  .collez .tv-ecran { position: absolute; inset: 0; display: flex; align-items: center; gap: 6cqw; padding: 0 7cqw; color: #f5f5f7; text-align: left; }
  .collez .tv-qr { flex: none; width: 33cqw; aspect-ratio: 1; display: grid; place-items: center; border-radius: 2.5cqw; background: #141416; }
  .collez .tv-qr svg { width: 80%; height: 80%; padding: 6%; box-sizing: border-box; background: #fff; border-radius: 2cqw; }
  .collez .tv-texte { min-width: 0; }
  .collez .tv-texte p { margin: 0; }
  .collez .tv-titre { font-size: 4.2cqw; font-weight: 800; letter-spacing: -0.02em; line-height: 1.1; }
  .collez .tv-etapes { margin: 2.6cqw 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 1.3cqw; font-size: 1.75cqw; line-height: 1.3; }
  .collez .tv-etapes li { display: flex; align-items: center; gap: 1.4cqw; }
  .collez .tv-etapes span { flex: none; width: 3.2cqw; height: 3.2cqw; border-radius: 50%; display: grid; place-items: center; background: #f5f5f7; color: #000; font-weight: 700; font-size: 1.6cqw; }
  .collez .tv-code-titre { margin-top: 3cqw !important; font-size: 1.5cqw; font-weight: 600; color: #8e8e93; }
  .collez .tv-code { font-size: 6.2cqw; font-weight: 800; line-height: 1.1; letter-spacing: 0.02em; }
  .collez .tv-valable { margin-top: 0.8cqw !important; font-size: 1.45cqw; line-height: 1.35; color: #a1a1a6; }

  .collez .commandes { position: relative; z-index: 2; margin-top: 2rem; flex-wrap: nowrap; }
  .collez .pastilles button { padding-left: 0.875rem; padding-right: 0.875rem; }
  .collez .legendes { display: grid; margin: 1.25rem auto 0; max-width: 24rem; }
  .collez .legendes .legende { grid-area: 1 / 1; visibility: hidden; }
  .collez .legendes .legende.active { visibility: visible; }
  .collez .legende { margin: 0; text-align: center; font-size: 1.0625rem; line-height: 1.5; color: #a1a1a6; }

  /* Téléphone flottant : coins arrondis, liseré blanc très fin, ombre profonde (comme l'Apple TV, .ecrin-tv).
     Tailles en unités du conteneur (cqw) : le dessin garde ses proportions à toutes les largeurs. */
  .collez .telephone { position: relative; z-index: 1; container-type: inline-size; }
  .collez .ecran { position: relative; aspect-ratio: 1320 / 2868; overflow: hidden; background: #000; border-radius: 13cqw; box-shadow: 0 0 0 1px rgba(255,255,255,0.16), 0 2.5rem 7.5rem rgba(0,0,0,0.9); }
  .collez .tableau { position: absolute; inset: 0; font-size: 4.4cqw; line-height: 1.3; color: #f5f5f7; text-align: left; }
  .collez .tableau picture, .collez .tableau .capture { display: block; width: 100%; height: 100%; }
  .collez .barre-etat { padding: 5.5cqw 9cqw 0; font-size: 4.6cqw; font-weight: 600; }

  /* Tableau 1 : messagerie générique (aucune couleur ni forme d'une vraie messagerie). */
  .collez .entete-msg { display: flex; flex-direction: column; align-items: center; gap: 1.5cqw; padding: 5cqw 0 4cqw; border-bottom: 1px solid #242428; }
  .collez .avatar { width: 13cqw; height: 13cqw; border-radius: 50%; background: #3a3a3e; display: grid; place-items: center; font-weight: 700; font-size: 5.5cqw; }
  .collez .expediteur { font-size: 3.6cqw; color: #d1d1d6; }
  .collez .fil { position: relative; padding: 8cqw 5cqw 0; }
  .collez .copier { position: absolute; left: 5cqw; top: 0.5cqw; padding: 1.8cqw 4cqw; border-radius: 2.5cqw; background: #3a3a3e; color: #fff; font-size: 3.8cqw; font-weight: 600; }
  .collez .copier::after { content: ""; position: absolute; left: 7cqw; bottom: -1.6cqw; border: 1.8cqw solid transparent; border-bottom: 0; border-top-color: #3a3a3e; }
  .collez .bulle { margin-top: 2cqw; max-width: 90%; padding: 3cqw 4cqw; border-radius: 5cqw 5cqw 5cqw 1.5cqw; background: #242428; overflow-wrap: anywhere; }
  .collez .bulle span { display: block; border-radius: 1cqw; }
  .collez .bulle .lien { font-size: 4.1cqw; white-space: nowrap; text-decoration: underline; text-decoration-color: #8e8e93; }
  .collez .heure { margin: 2cqw 0 0 1cqw; font-size: 3.2cqw; color: #a1a1a6; }
  .collez .saisie { position: absolute; left: 5cqw; right: 5cqw; bottom: 6cqw; height: 10cqw; border-radius: 5cqw; border: 1px solid #3a3a3e; }

  /* Tableaux 2 et 3 : écran « Ajouter un abonnement » d'Ulti. */
  .collez .app { padding: 6cqw 5cqw 0; }
  .collez .logo { display: inline-flex; align-items: center; gap: 2cqw; font-size: 5cqw; font-weight: 800; letter-spacing: -0.02em; }
  .collez .logo svg { width: 6.5cqw; height: 6.5cqw; }
  .collez .logo .suffixe { font-weight: 600; color: #a1a1a6; }
  .collez .grand-titre { margin: 2.5cqw 0 5cqw; font-size: 8.4cqw; line-height: 1.08; font-weight: 800; letter-spacing: -0.02em; }
  .collez .groupe { background: #141416; border-radius: 4cqw; }
  .collez .coller { display: flex; align-items: center; gap: 3cqw; padding: 3.5cqw 4cqw; }
  .collez .coller strong { display: block; font-size: 4.2cqw; }
  .collez .coller small { display: block; margin-top: 1cqw; font-size: 3.2cqw; line-height: 1.3; color: #a1a1a6; }
  .collez .pilule { position: relative; flex: none; display: inline-flex; align-items: center; gap: 1.2cqw; padding: 2cqw 3.4cqw; border-radius: 999px; background: #3a3a3e; color: #fff; font-size: 3.6cqw; font-weight: 600; }
  .collez .pilule svg { width: 3.4cqw; height: 3.4cqw; }
  .collez .trouve { display: flex; gap: 1.8cqw; padding: 3cqw 4cqw; border-top: 1px solid #242428; font-size: 3.3cqw; color: #a1a1a6; }
  .collez .trouve svg { flex: none; width: 3.8cqw; height: 3.8cqw; margin-top: 0.3cqw; }
  .collez .champs { margin-top: 4cqw; }
  .collez .champ { position: relative; padding: 3.4cqw 4cqw; font-size: 3.9cqw; color: #8e8e93; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .collez .champ + .champ { border-top: 1px solid #242428; }
  .collez .champ .valeur { position: absolute; inset: 0; padding: 3.4cqw 4cqw; color: #f5f5f7; background: #141416; }
  .collez .champ .eclat { position: absolute; inset: 0; background: rgba(255,255,255,0.09); opacity: 0; }
  .collez .champ:first-child, .collez .champ:first-child > span { border-radius: 4cqw 4cqw 0 0; }
  .collez .champ:last-child, .collez .champ:last-child > span { border-radius: 0 0 4cqw 4cqw; }
  .collez .pied { margin: 2cqw 4cqw 0; font-size: 3.1cqw; color: #a1a1a6; }
  .collez .continuer { position: relative; overflow: hidden; margin-top: 5cqw; height: 11cqw; border-radius: 3cqw; display: grid; place-items: center; font-size: 4.2cqw; font-weight: 700; background: #2c2c2e; color: #a1a1a6; }
  .collez .continuer .allume { position: absolute; inset: 0; display: grid; place-items: center; background: #f5f5f7; color: #000; opacity: 0; }
  .collez .doigt { position: absolute; pointer-events: none; width: 11cqw; height: 11cqw; margin: -5.5cqw 0 0 -5.5cqw; border-radius: 50%; background: rgba(255,255,255,0.32); border: 1px solid rgba(255,255,255,0.7); left: 50%; top: 50%; opacity: 0; }

  /* Animations dans un tableau : elles démarrent quand il s'affiche (classe active ; visite.js les relance quand la
     section arrive à l'écran). Elles vont jusqu'au bout même si le visiteur a pris la main. */
  .collez .active .t-message .bulle span { animation: collez-surligne 0.25s ease-out both; }
  .collez .active .t-message .bulle span:nth-child(2) { animation-delay: 0.85s; }
  .collez .active .t-message .bulle span:nth-child(1) { animation-delay: 0.7s; }
  .collez .active .t-message .bulle span:nth-child(3) { animation-delay: 1s; }
  .collez .active .t-message .bulle span:nth-child(4) { animation-delay: 1.15s; }
  .collez .active .t-message .copier { animation: collez-apparait 0.3s ease-out 1.5s both; }
  .collez .active .t-coller .doigt { animation: collez-doigt 1.5s ease-in-out 0.3s both; }
  .collez .active .t-coller .pilule { animation: collez-appui 0.2s ease-in-out 1.55s both; }
  .collez .active .t-coller .groupe:first-of-type { animation: collez-colle 0.6s ease-out 1.65s both; }
  .collez .active .t-remplir .valeur { animation: collez-tape 0.45s steps(12, end) both; }
  .collez .active .t-remplir .eclat { animation: collez-eclat 1.1s ease-out both; }
  .collez .active .t-remplir .champ:nth-child(1) > span { animation-delay: 0.3s; }
  .collez .active .t-remplir .champ:nth-child(2) > span { animation-delay: 0.8s; }
  .collez .active .t-remplir .champ:nth-child(3) > span { animation-delay: 1.3s; }
  .collez .active .t-remplir .trouve { animation: collez-apparait 0.35s ease-out 1.9s both; }
  .collez .active .t-remplir .allume { animation: collez-allume 0.4s ease-out 2.4s both; }
  @keyframes collez-surligne { from { background: transparent; } to { background: rgba(255,255,255,0.22); } }
  @keyframes collez-apparait { from { opacity: 0; transform: translateY(1.5cqw); } to { opacity: 1; transform: none; } }
  @keyframes collez-doigt { 0% { opacity: 0; transform: translate(-25cqw, 110cqw); } 20% { opacity: 1; } 70% { transform: none; } 85% { transform: scale(0.82); } 100% { opacity: 1; transform: none; } }
  @keyframes collez-colle { 0% { background: #141416; } 30% { background: #2c2c2e; } 100% { background: #141416; } }
  @keyframes collez-appui { 0%, 100% { background: #3a3a3e; } 50% { background: #636366; } }
  @keyframes collez-tape { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
  @keyframes collez-eclat { 0% { opacity: 0; } 15% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes collez-allume { from { opacity: 0; } to { opacity: 1; } }

  /* Figé (?tableau=…, sans JavaScript, « réduire les animations ») : chaque tableau dans son état final. */
  .collez .fige .t-message .bulle span { background: rgba(255,255,255,0.22); }
  .collez .fige .t-coller .doigt, .collez .fige .allume { opacity: 1; }
  .collez .fige .tableau *, .collez .fige .active .tableau * { animation: none !important; }

  /* Sans JavaScript ou « réduire les animations » : les 4 tableaux côte à côte. */
  .collez .grille { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 1.25rem; }
  .collez .grille .ecran { box-shadow: 0 0 0 1px rgba(255,255,255,0.16); }
  .collez .grille .legende { margin-top: 0.875rem; font-size: 0.9375rem; line-height: 1.45; }
  .collez .grille .numero { display: block; margin-bottom: 0.25rem; color: #f5f5f7; font-size: 0.8125rem; font-weight: 600; }
  @media (prefers-reduced-motion: reduce) {
    html.js .collez .avec-js { display: none !important; }
    html.js .collez .grille.sans-js { display: grid !important; }
  }

  /* Les 3 étapes, en une ligne. */
  .collez .etapes { margin: 5rem 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .collez .etapes li { border-top: 2px solid #3a3a3e; padding-top: 1.25rem; }
  .collez .etapes li:first-child { border-top-color: #f5f5f7; }
  .collez .etapes h3 { margin: 0; display: flex; gap: 0.625rem; align-items: baseline; font-size: 1.1875rem; font-weight: 700; letter-spacing: -0.01em; }
  .collez .etapes .numero { font-size: 0.875rem; color: #8e8e93; }
  .collez .etapes p { margin: 0.5rem 0 0; font-size: 0.9375rem; line-height: 1.5; color: #a1a1a6; }
  .collez .minute { margin: 1.75rem 0 0; text-align: center; font-size: 0.9375rem; font-weight: 600; color: #d1d1d6; }

  @media (max-width: 52rem) {
    .collez .duo { margin-top: 3rem; grid-template-columns: minmax(0, 1fr); grid-template-areas: "tel" "ttel" "tv" "ttv"; gap: 2rem; }
    .collez .appareil-tv { margin-top: 2rem; }
    .collez .texte-tel, .collez .texte-tv { align-self: start; }
    .collez .scene { width: min(100%, 17rem); }
    .collez .commandes { flex-wrap: wrap; }
    .collez .etapes { grid-template-columns: minmax(0, 1fr); margin-top: 3rem; }
  }
</style>
