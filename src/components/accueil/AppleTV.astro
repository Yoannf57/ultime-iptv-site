---
import { t } from "../../lib/textes";
import { captures } from "../../lib/captures";
import Capture from "./Capture.astro";
interface Props { langue: string }
const { langue: l } = Astro.props;
const { appareil, capture } = captures.appletv;
---
<section id="apple-tv" aria-labelledby="titre-tv" class="bande">
  <div class="interieur apparition">
    <div class="texte">
      <p class="surtitre">{t(l, "appletv.surtitre")}</p>
      <h2 id="titre-tv" class="titre-section">{t(l, "appletv.titre")}</h2>
      <p class="chapeau">{t(l, "appletv.texte")}</p>
      <ul>
        {["point1", "point2", "point3"].map((p) => (
          <li>
            <svg class="coche" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" /></svg>
            {t(l, `appletv.${p}`)}
          </li>
        ))}
      </ul>
    </div>
    <div class="visuel">
      <div class="ecrin-tv tele">
        <Capture langue={l} appareil={appareil} capture={capture} sizes="(max-width: 60rem) 92vw, 34rem" />
      </div>
    </div>
  </div>
</section>

<style>
  .bande { background: #0a0a0b; border-top: 1px solid #1c1c1e; border-bottom: 1px solid #1c1c1e; }
  .interieur { max-width: 75rem; margin: 0 auto; padding: 7.5rem 1.5rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4rem; }
  .texte { flex: 1 1 26.25rem; min-width: 0; }
  .chapeau { margin-top: 1.5rem; }
  ul { margin: 2rem 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 0.875rem; font-size: 1.0625rem; }
  li { display: flex; gap: 0.75rem; align-items: baseline; }
  .visuel { flex: 1 1 27.5rem; min-width: 0; display: flex; justify-content: center; }
  .tele { width: 100%; max-width: 34rem; box-shadow: 0 0 0 1px rgba(255,255,255,0.16), 0 1.875rem 5.625rem rgba(0,0,0,0.9), 0 0 8.75rem rgba(255,255,255,0.07); }
</style>
