---
// Écran Apple TV dessiné en 16:9 (maquette Ecran.dc.html), en attendant les vraies captures de S4.
// « vues » : les écrans à préparer ; seul « initiale » est visible au départ (les autres s'affichent au clic).
// « barre » : la barre d'onglets de l'app en haut (cliquable).
import { t } from "../../lib/textes";
import { ecrans, chaine, titre, anneau } from "../../lib/ecrans";

interface Props { langue: string; id: string; vues: string[]; initiale?: string; barre?: boolean }
const { langue: l, id, vues, initiale = vues[0], barre = false } = Astro.props;
const filtres = ["tout", "cinema", "info", "jeunesse", "sciences"];
const g = ecrans.guide;
---
<div class:list={["ecran-tv", { "avec-barre": barre }]} data-ecran={id}>
  {barre && (
    <nav class="barre" aria-label={t(l, "apercu.ongletsTV")}>
      <div class="pilule">
        {ecrans.ongletsTV.map((o) => (
          <button type="button" data-cible={id} data-vue={o} aria-pressed={o === initiale ? "true" : "false"}>{t(l, `onglets.${o}`)}</button>
        ))}
      </div>
    </nav>
  )}

  {vues.includes("accueil") && (
    <div class="vue vue-accueil" data-vue="accueil" hidden={initiale !== "accueil"} aria-hidden="true">
      <div class="fond-1"></div><div class="fond-2"></div><div class="fond-3"></div>
      <div class="vedette">
        <p class="genre">{t(l, "ecrans.sintelGenre")}</p>
        <p class="grand-titre">{ecrans.vedette.film}</p>
        <p class="resume">{t(l, "ecrans.sintelResume")}</p>
        <div class="boutons"><span class="b-blanc">{t(l, "ecrans.lecture")}</span><span class="b-gris">{t(l, "ecrans.maListe")}</span></div>
      </div>
      <div class="rangee-direct">
        <p class="rangee-titre">{t(l, "ecrans.enDirect")}</p>
        <div class="ronds">
          {ecrans.tvAccueil.map((e) => { const c = chaine(e.chaine); return (
            <div class="rond-bloc">
              <div class="rond" style={`background:${anneau(e.avance, c.info)}`}>
                <div class="rond-logo" style={`background:${c.fond};font-size:${e.taille}cqw;font-family:${c.police};letter-spacing:${e.espace}`}>{c.logo}</div>
              </div>
              <span class="rond-titre">{titre(e, l)}</span>
            </div>
          ); })}
        </div>
      </div>
    </div>
  )}

  {vues.includes("direct") && (
    <div class="vue vue-page" data-vue="direct" hidden={initiale !== "direct"} aria-hidden="true">
      <p class="page-titre">{t(l, "onglets.direct")}</p>
      <div class="puces">{filtres.map((f, i) => <span class:list={["puce", { active: i === 0 }]}>{t(l, `ecrans.filtres.${f}`)}</span>)}</div>
      <div class="grille-4">
        {ecrans.direct.map((d) => { const c = chaine(d.chaine); return (
          <div class="tuile">
            <div class="tuile-image" style={`background:${d.image}`}>
              <span class="tuile-logo" style={`background:${c.fond};font-family:${c.police}`}>{c.logo}</span>
              {c.info && <span class="badge-direct">{t(l, "ecrans.badgeDirect")}</span>}
            </div>
            <div class="tuile-texte">
              <p class="tuile-titre">{titre(d, l)}</p>
              <p class="tuile-heure">{d.heure}</p>
              <div class="avance"><div style={`width:${d.avance}%`}></div></div>
            </div>
          </div>
        ); })}
      </div>
    </div>
  )}

  {vues.includes("guide") && (
    <div class="vue vue-page" data-vue="guide" hidden={initiale !== "guide"} aria-hidden="true">
      <div class="ligne-titre"><p class="page-titre">{t(l, "onglets.guide")}</p><p class="page-sous">{t(l, "ecrans.guideDate")}</p></div>
      <div class="guide">
        <div class="guide-heures">{g.heures.map((h) => <span>{h}</span>)}</div>
        <div class="guide-lignes">
          {g.lignes.map((ligne) => { const c = chaine(ligne.chaine); return (
            <div class="guide-ligne">
              <div class="guide-logo" style={`background:${c.fond};font-family:${c.police}`}>{c.logo}</div>
              <div class="guide-progs">
                {ligne.progs.map((p) => (
                  <div class:list={["prog", { encours: p.encours }]} style={`flex:${p.duree} 1 0`}>
                    <p class="prog-titre">{titre(p, l)}</p><p class="prog-heure">{p.heure}</p>
                  </div>
                ))}
              </div>
            </div>
          ); })}
        </div>
        <div class="maintenant" style={`left:calc(11cqw + ${g.maintenant}%)`}></div>
      </div>
    </div>
  )}

  {vues.includes("replay") && (
    <div class="vue vue-page" data-vue="replay" hidden={initiale !== "replay"} aria-hidden="true">
      <p class="page-titre">{t(l, "onglets.replay")}</p>
      <div class="puces">{ecrans.replayJours.map((j) => <span class:list={["puce", { active: j === ecrans.replayJourActif }]}>{t(l, `ecrans.jours.${j}`)}</span>)}</div>
      <div class="grille-4">
        {ecrans.replay.map((r) => { const c = chaine(r.chaine); return (
          <div>
            <div class="tuile-image arrondie" style={`background:${r.image}`}>
              <span class="tuile-logo bas" style={`background:${c.fond};font-family:${c.police}`}>{c.logo}</span>
              <span class="duree chiffres">{r.duree}</span>
            </div>
            <p class="replay-titre">{titre(r, l)}</p>
            <p class="tuile-heure">{t(l, "ecrans.quand", { jour: t(l, `ecrans.jours.${ecrans.replayJourActif}`), heure: r.heure })}</p>
          </div>
        ); })}
      </div>
    </div>
  )}

  {vues.includes("films") && (
    <div class="vue vue-page" data-vue="films" hidden={initiale !== "films"} aria-hidden="true">
      <div class="ligne-titre"><p class="page-titre">{t(l, "onglets.films")}</p><p class="page-sous">{t(l, "ecrans.filmsGenres")}</p></div>
      <div class="grille-7">
        {ecrans.films.map((f) => (
          <div><div class="affiche" style={`background:${f.fond}`}>{f.affiche}</div><p class="annee">{f.annee}</p></div>
        ))}
      </div>
    </div>
  )}

  {vues.includes("series") && (
    <div class="vue vue-series" data-vue="series" hidden={initiale !== "series"} aria-hidden="true">
      <div class="serie-vedette">
        <div>
          <p class="genre clair">{t(l, "ecrans.serieGenre")}</p>
          <p class="grand-titre serie">{ecrans.vedette.serie}</p>
          <p class="resume clair">{t(l, "ecrans.serieResume")}</p>
        </div>
      </div>
      <div class="serie-liste">
        <div class="puces sans-marge"><span class="puce active">{t(l, "ecrans.episodes")}</span><span class="puce">{t(l, "ecrans.version")}</span></div>
        <div class="episodes">
          {ecrans.episodes.map((e) => (
            <div class="episode">
              <div class="episode-image" style={`background:${e.image}`}><div style={`width:${e.vu}%`}></div></div>
              <div>
                <p class="tuile-heure">{t(l, "ecrans.episode", { numero: String(e.numero), annee: e.annee })}</p>
                <p class="episode-titre">{e.titre}</p>
                <p class="episode-etat">{t(l, `ecrans.etats.${e.etat}`)}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  )}
</div>

<style>
  .ecran-tv { container-type: inline-size; position: relative; width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: #000; color: #f5f5f7; text-align: left; }
  .ecran-tv p { margin: 0; }
  .vue { position: absolute; inset: 0; }
  .vue[hidden] { display: none; }
  .vue.entree { animation: fondu 0.2s ease-out; }
  @keyframes fondu { from { opacity: 0; } to { opacity: 1; } }

  /* Barre d'onglets */
  .barre { position: absolute; z-index: 3; top: 3.2cqw; left: 0; right: 0; display: flex; justify-content: center; pointer-events: none; }
  .pilule { display: flex; gap: 0.4cqw; padding: 0.45cqw; border-radius: 999px; background: rgba(60, 60, 67, 0.62); -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); pointer-events: auto; }
  .pilule button { border: 0; cursor: pointer; font: inherit; font-size: 1.15cqw; font-weight: 600; padding: 0.55cqw 1.4cqw; border-radius: 999px; background: transparent; color: #d1d1d6; }
  .pilule button[aria-pressed="true"] { background: #f5f5f7; color: #000; }
  .pilule button:focus-visible { outline: 0.2cqw solid #f5f5f7; outline-offset: 0.2cqw; }

  /* Accueil */
  .fond-1 { position: absolute; inset: 0; background: #1b2a3a; }
  .fond-2 { position: absolute; left: 0; right: 0; top: 0; height: 62%; background: linear-gradient(90deg, #41698c 0%, #29486a 50%, #15263a 100%); }
  .fond-3 { position: absolute; left: 0; right: 0; top: 38%; bottom: 0; background: linear-gradient(180deg, rgba(0,0,0,0) 0%, #000 48%); }
  .vedette { position: absolute; left: 4.5cqw; top: 11cqw; }
  .genre { font-size: 1.1cqw; font-weight: 700; letter-spacing: 0.08em; color: #a1a1a6; text-transform: uppercase; }
  .genre.clair { color: #e5ead9; }
  .grand-titre { margin-top: 0.6cqw !important; font-size: 5.2cqw; font-weight: 800; letter-spacing: -0.04em; line-height: 1; }
  .grand-titre.serie { font-size: 5cqw; }
  .resume { margin-top: 1cqw !important; max-width: 34cqw; font-size: 1.25cqw; line-height: 1.4; color: #c7c7cc; }
  .resume.clair { color: #e5ead9; }
  .boutons { margin-top: 1.6cqw; display: flex; gap: 0.8cqw; }
  .b-blanc, .b-gris { font-size: 1.2cqw; font-weight: 700; padding: 0.8cqw 2cqw; border-radius: 0.7cqw; }
  .b-blanc { background: #f5f5f7; color: #000; }
  .b-gris { background: rgba(120,120,128,0.36); color: #f5f5f7; }
  .rangee-direct { position: absolute; left: 4.5cqw; right: 0; bottom: 3cqw; }
  .rangee-titre { margin-bottom: 1.2cqw !important; font-size: 1.45cqw; font-weight: 700; }
  .ronds { display: flex; gap: 2cqw; }
  .rond-bloc { display: flex; flex-direction: column; align-items: center; gap: 0.7cqw; width: 8cqw; }
  .rond { width: 7cqw; height: 7cqw; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
  .rond-logo { width: 6.1cqw; height: 6.1cqw; border-radius: 50%; display: flex; align-items: center; justify-content: center; text-align: center; line-height: 1; font-weight: 800; color: #fff; }
  .rond-titre { font-size: 0.95cqw; color: #a1a1a6; white-space: nowrap; max-width: 8cqw; overflow: hidden; text-overflow: ellipsis; }

  /* Pages (direct, guide, replay, films) */
  .vue-page { padding: 4cqw 4.5cqw 4cqw; }
  .avec-barre .vue-page { padding-top: 8cqw; }
  .page-titre { font-size: 3cqw; font-weight: 800; letter-spacing: -0.03em; }
  .page-sous { font-size: 1.3cqw; color: #a1a1a6; }
  .ligne-titre { display: flex; justify-content: space-between; align-items: baseline; }
  .puces { margin-top: 1.2cqw; display: flex; gap: 0.8cqw; font-size: 1.2cqw; font-weight: 600; }
  .puces.sans-marge { margin-top: 0; }
  .puce { padding: 0.6cqw 1.5cqw; border-radius: 999px; background: #242428; color: #d1d1d6; white-space: nowrap; }
  .puce.active { background: #f5f5f7; color: #000; }
  .grille-4 { margin-top: 2cqw; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.4cqw; }
  .tuile { border-radius: 1.2cqw; overflow: hidden; background: #141416; }
  .tuile-image { position: relative; aspect-ratio: 16 / 9; }
  .tuile-image.arrondie { border-radius: 1.2cqw; }
  .tuile-logo { position: absolute; left: 0.9cqw; top: 0.9cqw; padding: 0.35cqw 0.9cqw; border-radius: 0.5cqw; font-size: 0.95cqw; font-weight: 800; letter-spacing: 0.03em; color: #fff; }
  .tuile-logo.bas { top: auto; bottom: 0.9cqw; }
  .badge-direct { position: absolute; right: 0.9cqw; top: 0.9cqw; padding: 0.35cqw 0.8cqw; border-radius: 0.5cqw; background: #ff3b30; font-size: 0.85cqw; font-weight: 800; color: #fff; }
  .duree { position: absolute; right: 0.9cqw; bottom: 0.9cqw; padding: 0.35cqw 0.8cqw; border-radius: 0.5cqw; background: rgba(0,0,0,0.6); font-size: 0.95cqw; font-weight: 700; color: #fff; }
  .tuile-texte { padding: 0.8cqw 1.1cqw 1cqw; }
  .tuile-titre { font-size: 1.3cqw; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tuile-heure { margin-top: 0.3cqw !important; font-size: 1.05cqw; color: #8e8e93; font-variant-numeric: tabular-nums; }
  .avance { margin-top: 0.8cqw; height: 0.35cqw; border-radius: 999px; background: #3a3a3e; overflow: hidden; }
  .avance div { height: 100%; background: #f5f5f7; }
  .replay-titre { margin-top: 1cqw !important; font-size: 1.35cqw; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .guide { margin-top: 2.2cqw; position: relative; }
  .guide-heures { display: flex; padding-left: 11cqw; font-size: 1.1cqw; color: #8e8e93; font-variant-numeric: tabular-nums; }
  .guide-heures span { flex: 1; }
  .guide-lignes { margin-top: 1cqw; display: flex; flex-direction: column; gap: 0.8cqw; }
  .guide-ligne { display: flex; gap: 0.8cqw; height: 4.6cqw; }
  .guide-logo { flex: none; width: 10.2cqw; border-radius: 0.8cqw; display: flex; align-items: center; justify-content: center; font-size: 1.15cqw; font-weight: 800; color: #fff; }
  .guide-progs { flex: 1; display: flex; gap: 0.5cqw; min-width: 0; }
  .prog { min-width: 0; border-radius: 0.8cqw; background: #1c1c1e; padding: 0.8cqw 1cqw; overflow: hidden; }
  .prog.encours { background: #2c2c30; }
  .prog-titre { font-size: 1.15cqw; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .prog-heure { margin-top: 0.3cqw !important; font-size: 0.95cqw; color: #8e8e93; white-space: nowrap; font-variant-numeric: tabular-nums; }
  /* Ligne de l'heure actuelle : blanche (le rouge est réservé aux chaînes d'info, CLAUDE.md section 5). */
  .maintenant { position: absolute; top: 0; bottom: 0; width: 0.2cqw; background: #f5f5f7; box-shadow: 0 0 0.6cqw rgba(0,0,0,0.6); }

  .grille-7 { margin-top: 2cqw; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 1.4cqw; }
  .affiche { aspect-ratio: 2 / 3; border-radius: 1cqw; display: flex; align-items: flex-end; padding: 1cqw; font-size: 1.25cqw; line-height: 1.05; font-weight: 800; letter-spacing: 0.02em; color: #fff; }
  .annee { margin-top: 0.7cqw !important; font-size: 1.1cqw; color: #8e8e93; }

  .vue-series { display: flex; }
  .serie-vedette { flex: 0 0 44%; background: linear-gradient(160deg, #6e8f3c 0%, #3d5a22 60%, #1e2d12 100%); display: flex; align-items: flex-end; padding: 4.5cqw; }
  .serie-liste { flex: 1; padding: 4.5cqw; }
  .avec-barre .serie-liste { padding-top: 8cqw; }
  .episodes { margin-top: 2.4cqw; display: flex; flex-direction: column; gap: 1.6cqw; }
  .episode { display: flex; gap: 1.6cqw; align-items: center; }
  .episode-image { flex: none; width: 16cqw; aspect-ratio: 16 / 9; border-radius: 1cqw; position: relative; overflow: hidden; }
  .episode-image div { position: absolute; left: 0; bottom: 0; height: 0.4cqw; background: #f5f5f7; }
  .episode-titre { margin-top: 0.3cqw !important; font-size: 1.5cqw; font-weight: 700; }
  .episode-etat { margin-top: 0.3cqw !important; font-size: 1.1cqw; color: #a1a1a6; }

  @media (prefers-reduced-motion: reduce) { .vue.entree { animation: none; } }
</style>
